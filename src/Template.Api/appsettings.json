{
  "ServiceName": "Template.Api",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Nexus": {
    "BaseUrl": "http://nexus-api.nexus-live.svc.cluster.local",
    "ApiKey": "",
    "ApplicationId": "",
    "Environment": "",
    "Version": "",
    "EnableAutoRegistration": true,
    "FeatureCacheTtlSeconds": 300,
    "DefaultFeatureEnabled": true,
    "TimeoutSeconds": 10
  },
  "OpenTelemetry": {
    "Endpoint": "http://otel-collector.monitoring.svc.cluster.local:4317"
  },
  "Swagger": {
    "EnableUI": false
  }
}

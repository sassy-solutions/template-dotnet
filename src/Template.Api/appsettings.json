{
  "ServiceName": "Template.Api",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Nexus": {
    "BaseUrl": "http://nexus-api-live.nexus-live.svc.cluster.local",
    "ApiKey": "",
    "ApplicationId": "",
    "Environment": "",
    "Version": "",
    "EnableAutoRegistration": true,
    "FeatureCacheTtlSeconds": 300,
    "DefaultFeatureEnabled": true,
    "TimeoutSeconds": 10,
    "Diagnostics": {
      "Enabled": false
    }
  },
  "Zitadel": {
    "_comment": "JWT-bearer auth. Injected at deploy by Nexus (Zitadel__Authority / Zitadel__Audience). Empty here → auth is off (local/dev runs open). Audience = the per-(project,environment) Zitadel project id, so a dev token is rejected in prod.",
    "Authority": "",
    "Audience": "",
    "MetadataAddress": ""
  },
  "OpenTelemetry": {
    "Endpoint": "http://otel-collector.monitoring.svc.cluster.local:4317"
  },
  "Swagger": {
    "EnableUI": false
  }
}

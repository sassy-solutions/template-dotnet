<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget.org only, and nothing inherited from the machine (<clear />). The Nexus SDK is
    SassySolutions.Nexus.Sdk on nuget.org; "Nexus.Sdk" there belongs to an unrelated
    publisher, which Directory.Build.props refuses outright (ForbidUnscopedNexusPackages).
    The explicit patterns document which of our packages come from here; with a single
    source they resolve the same as "*".
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="SassySolutions.*" />
      <package pattern="Compendium.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
